<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#090909" />
    <title>@ViewData["Title"] · Team Portfolio</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <a class="wordmark" asp-controller="Home" asp-action="Index" aria-label="Team portfolio home">
            <span class="wordmark-mark" aria-hidden="true"></span>
            <span>TEAM<span class="wordmark-period">/</span>PORTFOLIO</span>
        </a>
        <nav class="site-nav" aria-label="Main navigation">
            <a asp-controller="Home" asp-action="Index">Profiles</a>
            <a href="/#project">Project</a>
        </nav>
        <span class="header-label">MVC TEMPLATE</span>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="site-footer">
        <a class="wordmark footer-wordmark" asp-controller="Home" asp-action="Index">
            <span class="wordmark-mark" aria-hidden="true"></span>
            <span>TEAM<span class="wordmark-period">/</span>PORTFOLIO</span>
        </a>
        <span>SHARED PROFILE TEMPLATE</span>
        <a class="back-top" href="#top">Back to top ↑</a>
    </footer>
</body>
</html>