@model IReadOnlyList<MemberProfile>
@{
    ViewData["Title"] = "Team portfolio template";
}

<section class="hero" id="top">
    <div class="hero-copy">
        <p class="eyebrow"><span class="eyebrow-dot"></span> A SHARED SPACE FOR INDIVIDUAL WORK</p>
        <h1>Room to make<br /><span>your mark.</span></h1>
        <p class="hero-intro">A flexible portfolio template for a team, its work, and the people behind it.</p>
        <a class="text-link" href="#team">View profile templates <span aria-hidden="true">↓</span></a>
    </div>
    <div class="hero-art" aria-label="Abstract geometric composition">
        <div class="hero-photo-main" aria-hidden="true">
            <span class="hero-shape hero-shape-one"></span>
            <span class="hero-shape hero-shape-two"></span>
            <span class="hero-shape hero-shape-three"></span>
            <span class="hero-coordinate">FORM / COLOR / IDEAS</span>
        </div>
        <div class="hero-note"><span>TEAM PORTFOLIO</span><strong>Made to be<br />made yours.</strong><i>↗</i></div>
        <span class="hero-index">DESIGN / BUILD / SHARE</span>
    </div>
</section>

<section class="team-section" id="team">
    <div class="section-heading">
        <div>
            <p class="eyebrow">REUSABLE PAGES</p>
            <h2>Profile templates<span class="wordmark-period">.</span></h2>
        </div>
        <p class="section-note">A consistent page for every contributor.<br />Personal details are intentionally blank.</p>
    </div>
    <div class="member-grid">
        @for (var index = 0; index < Model.Count; index++)
        {
            var member = Model[index];
            <a class="member-card" asp-controller="Profiles" asp-action="Details" asp-route-id="@member.Slug">
                <div class="member-image-wrap">
                    @if (!string.IsNullOrWhiteSpace(member.ImageUrl))
                    {
                        <img src="@member.ImageUrl" alt="" loading="lazy" />
                    }
                    else
                    {
                        <div class="profile-art" aria-hidden="true"><span class="profile-art-label">PROFILE</span></div>
                    }
                    <span class="member-number">0@(index + 1)</span>
                    <span class="member-arrow" aria-hidden="true">↗</span>
                </div>
                <div class="member-meta">
                    <div>
                        <h3>Profile template</h3>
                        <p>Blank · ready to customize</p>
                    </div>
                    <span class="member-view">VIEW PROFILE</span>
                </div>
            </a>
        }
    </div>
</section>

<section class="project-band" id="project">
    <div class="project-stamp" aria-hidden="true">TEAM<br />PROJECT<br /><span>✳</span></div>
    <div class="project-copy">
        <p class="eyebrow">SHARED WORK</p>
        <h2>A place for work<br />to come together.</h2>
        <p>A flexible space for a team's ideas, process, and finished work.</p>
    </div>
    <div class="project-aside"><span>01</span><span>DESIGN<br />DEVELOP<br />LEARN</span></div>
</section>

<section class="closing-line">
    <p>Make the template your own<span class="wordmark-period">.</span></p>
    <a asp-controller="Home" asp-action="Index">Back to top ↑</a>
</section>